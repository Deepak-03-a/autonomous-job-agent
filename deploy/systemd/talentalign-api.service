[Unit]
Description=TalentAlign FastAPI service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=talentalign
WorkingDirectory=/opt/talentalign/backend
EnvironmentFile=/etc/talentalign/talentalign.env
ExecStart=/opt/talentalign/.venv/bin/uvicorn apps.api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
