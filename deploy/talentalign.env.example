DATABASE_URL=postgresql://talentalign:change-me@127.0.0.1:5432/talentalign
TALENTALIGN_API_TOKEN=replace-with-a-long-random-token
APP_ENV=production
# Leave empty for same-origin UI access. Add exact dev origins, comma-separated, only when needed.
CORS_ORIGINS=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=10m
# Optional licensed JSearch API. Results may be attributed to LinkedIn, Indeed,
# Glassdoor, Monster, and other boards. TalentAlign calls JSearch, not those sites.
JSEARCH_API_KEY=
JSEARCH_QUERIES=["software engineer in India","data analyst in India","devops engineer in India","product manager in India"]
# Optional: Adzuna listings, enabled when both credentials are set.
ADZUNA_APP_ID=
ADZUNA_API_KEY=
ADZUNA_COUNTRY=in
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
TALENTALIGN_BACKUP_DIR=/var/backups/talentalign
MAX_EXPORT_BYTES=26214400
